<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>compactgate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/CompactGate/bin/compactgate</string>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/CompactGate/dist/server/main.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/CompactGate</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>COMPACTGATE_CONFIG</key>
    <string>/ABSOLUTE/PATH/TO/CompactGate/compactgate.json</string>
    <key>PATH</key>
    <string>/ABSOLUTE/PATH/TO/NODE_BIN:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PATH/TO/CompactGate/compactgate.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PATH/TO/CompactGate/compactgate.stderr.log</string>
</dict>
</plist>

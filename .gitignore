llmdoc/

# Local debugging probes: they read this machine's real compactgate.json and
# hardcode profile ids, so they cannot run for anyone else and must not look
# like part of the test suite. `npm test` does not collect them.
/scripts/probes/

# Compiled launchd exec shim; rebuild with `npm run build:launcher`.
# Signed ad-hoc, and the signature is invalidated by any copy or rebuild.
/bin/compactgate

# LaunchAgent definition for this machine only: it hardcodes the absolute node
# path, the nvm version and this checkout's location. Install it with
# `cp scripts/compactgate.plist ~/Library/LaunchAgents/`.
/scripts/compactgate.plist
